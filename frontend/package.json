{
"name": "jone-frontend",
"version": "1.0.0",
"private": true,
"description": "Jone Frontend - Static website deployed on Cloudflare Workers",
"scripts": {
"dev": "wrangler dev",
"build": "node -e "const fs = require('fs'); if (!fs.existsSync('dist/index.html')) { console.error('Error: dist/index.html not found'); process.exit(1); } console.log('Static frontend build verified successfully.');"",
"deploy": "npm run build && wrangler deploy"
},
"devDependencies": {
"wrangler": "^4.151.3"
}
}