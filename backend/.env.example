# ===========================================================================
# J-ONE HOTEL & LODGE — Backend environment variables
# Copy to ".env" and fill in real values. NEVER commit a filled .env file.
# ===========================================================================

# --- Core Django -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DJANGO_DEBUG=True
# Comma-separated, no spaces
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Which settings module manage.py uses: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database --------------------------------------------------------------
# Development default is SQLite (nothing to set).
# Production: provide EITHER a full MySQL DATABASE_URL:
#   DATABASE_URL=mysql://user:password@host:3306/jone_hotel
# ...or the individual components below:
# DATABASE_URL=
# DB_NAME=jone_hotel
# DB_USER=jone
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Frontend / browser origins --------------------------------------------
# Public checkout origin, used for the default Paystack callback (no trailing
# slash). Local dev with frontend/dev_server.py: http://127.0.0.1:5500
# Production example: https://hotel.example.com
FRONTEND_URL=http://127.0.0.1:5500
# Optional independently hosted guest portal origin. Blank reuses FRONTEND_URL.
# The portal's runtime config still chooses API_BASE_URL independently.
PORTAL_FRONTEND_URL=
# Optional explicit Paystack callback page (defaults to {FRONTEND_URL}/payment-verify.html)
PAYMENT_CALLBACK_URL=
# Portal magic link (one use) and opaque in-memory session lifetime. Do not
# store portal session tokens in localStorage; the portal sends X-Portal-Session.
PORTAL_CHALLENGE_MINUTES=15
PORTAL_SESSION_HOURS=8
PORTAL_SESSION_TOUCH_MINUTES=15
PORTAL_CHALLENGES_PER_EMAIL_PER_HOUR=5
# Production ONLY: comma-separated exact browser origins allowed to call the
# API. Include every separately hosted public, management, and guest-portal
# frontend, if/when those origins exist. Use scheme + host only (no path or
# trailing slash), e.g.:
#   CORS_ALLOWED_ORIGINS=https://hotel.example.com,https://manage.example.com,https://guest.example.com
# Staff/public JWT calls and the portal's X-Portal-Session header are both
# header-authenticated; cross-origin cookies/credentials remain disabled. Do not
# use wildcard origins and never leave a production value pointed at examples.
CORS_ALLOWED_ORIGINS=
# Required by the strict production settings. Use matching exact HTTPS origins
# for Django-admin/forms or any explicitly introduced cookie-based flow.
CSRF_TRUSTED_ORIGINS=

# --- JWT -------------------------------------------------------------------
# Optional dedicated signing key (falls back to DJANGO_SECRET_KEY if blank)
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Paystack --------------------------------------------------------------
# From https://dashboard.paystack.com/#/settings/developers
# The SECRET key must never be exposed to the frontend (it lives ONLY on the
# backend host — never in any frontend configuration).
# Configure Paystack webhook URL to: https://<api-host>/api/payments/webhook/
# Required events: charge.success, refund.pending, refund.processing,
# refund.processed, refund.failed, and refund.needs-attention if available.
# Dashboard note: to make the hotel absorb Paystack transaction charges, keep
# Settings -> Preferences -> Transaction fees -> Pass fees to customers unchecked.
PAYSTACK_SECRET_KEY=
# Optional: the public key is not currently used by the redirect checkout flow.
PAYSTACK_PUBLIC_KEY=

# --- Backblaze B2 (media storage; S3-compatible) ---------------------------
# ALL FOUR must be set for uploads to go to B2. If any is missing the app falls
# back to the local disk, which is often EPHEMERAL in hosted production
# environments (uploads can vanish on deploy/restart) — check with:
# python manage.py check_media_storage
BACKBLAZE_KEY_ID=
BACKBLAZE_APPLICATION_KEY=
BACKBLAZE_BUCKET_NAME=
# Must include the scheme, e.g. https://s3.us-west-004.backblazeb2.com
BACKBLAZE_ENDPOINT=
# Optional: overrides the region parsed from the endpoint (e.g. us-west-004)
BACKBLAZE_REGION=
# Optional: your B2 friendly-URL/CDN host for serving media (no scheme needed)
MEDIA_CUSTOM_DOMAIN=
# Optional: absolute base URL used to build media links when no HTTP request is
# available (Celery tasks, management commands). Only needed with LOCAL media.
MEDIA_PUBLIC_BASE_URL=
# Development only: set True to exercise the real B2 backend locally.
USE_B2_IN_DEV=False

# --- Email (transactional) --------------------------------------------------
# Transactional email is PROVIDER-NEUTRAL. One variable picks the transport;
# everything else is ordinary connection detail. Delivery is SYNCHRONOUS —
# it happens inside the request, with no Celery, no Redis and no queue.
#
# EMAIL_PROVIDER accepts:
#   django | smtp | console   Django's own EMAIL_BACKEND (SMTP or console).
#   brevo | sendgrid | mailgun | postmark | resend
#                             That vendor's HTTPS API. No SMTP port needed —
#                             suitable for hosts that restrict outbound SMTP
#                             ports.
#   (empty)                   Auto: an API provider if a key is set, else Django.
# Production pins "brevo" by default; set this explicitly to switch vendors.
EMAIL_PROVIDER=

# --- API transport (EMAIL_PROVIDER = brevo/sendgrid/mailgun/postmark/resend) --
# Create the key in that vendor's dashboard. Never commit a real value.
EMAIL_API_KEY=
# Mailgun ONLY: the verified sending domain, e.g. mg.example.com. Required.
EMAIL_API_DOMAIN=
# Optional: override the vendor's API endpoint (regional hosts, e.g. Mailgun EU
# https://api.eu.mailgun.net). Blank uses the provider's documented default.
EMAIL_API_BASE_URL=
# Postmark ONLY: message stream. Default "outbound".
EMAIL_API_STREAM=outbound
# Legacy alias, still read so existing Brevo deployments keep working.
# Prefer EMAIL_API_KEY for new setups.
BREVO_API_KEY=

# --- SMTP transport (EMAIL_PROVIDER = django/smtp) ---------------------------
# Ignored by the API providers above. Any SMTP vendor works.
EMAIL_HOST=
EMAIL_PORT=587
# TLS (STARTTLS, port 587) and SSL (implicit TLS, port 465) are mutually
# exclusive — set exactly one. Most vendors use TLS on 587.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
# The SMTP key/password issued by the vendor, not your dashboard login.
# (Gmail: a 16-character App Password.) Never commit a real value.
EMAIL_HOST_PASSWORD=

# --- Shared ------------------------------------------------------------------
# Seconds before the provider request (HTTPS API or SMTP) is aborted. Bounded
# so one slow provider cannot hold a web worker until it is killed.
EMAIL_TIMEOUT=20
# MUST be an address verified as a sender with whichever provider is active,
# or the send is rejected. Do NOT wrap the value in quotes in host dashboards.
DEFAULT_FROM_EMAIL=J-one hotel & lodge <agbo33010@gmail.com>
# Absolute HTTPS URL of the logo used in email headers. Needed for providers
# that cannot deliver inline cid: images (Brevo's and Resend's APIs). The SMTP
# path and the other APIs embed the logo inline and ignore this.
EMAIL_LOGO_URL=
# Comma-separated staff inboxes for enquiry/cancellation/refund alerts.
# If blank, the configured hotel email is used.
HOTEL_NOTIFICATION_EMAILS=
#
# Verify the whole chain for the ACTIVE provider at any time:
#   python manage.py email_check                # config + auth + sender
#   python manage.py email_check --send you@x   # + one real delivery

# --- Redis / Celery --------------------------------------------------------
# REDIS_URL is a PRODUCTION variable: the Celery broker/result backend and
# cache location for the scheduled hotel tasks (pending-booking expiry,
# auto-checkout, checkout warnings). Email does NOT use this queue.
#
# DEVELOPMENT NEEDS NONE OF THIS. The development settings force eager,
# in-process task execution with an in-memory broker and NO result backend,
# so a local run never requires (or even contacts) Redis:
# Email is NOT affected either way: it is sent synchronously, never queued.
# To exercise the real Redis broker + Celery worker architecture locally, run
# with production-style settings instead of flipping these values.
REDIS_URL=redis://127.0.0.1:6379/0
# Production only: False (default) = tasks run on Celery workers via Redis.
CELERY_TASK_ALWAYS_EAGER=False

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=5
