+/* ===========================================================================
+   Batch 01, Task 5 — the REORDER dialog.
+
+   Reordering something the hotel already stocks must not mean re-typing its
+   name, SKU, category, unit and price. Staff select the stock item; the server
+   supplies its identity, unit, current balance, preferred supplier and the last
+   actual purchase cost (GET procurement/items/<id>/reorder-context/). The
+   dialog then asks only for what genuinely changes: how many, in which purchase
+   unit, at what price, from which supplier, for which store, expected when, and
+   any note.
+
+   The submission creates an ordinary purchase-order DRAFT through the existing
+   endpoint, so the procurement approval workflow is unchanged and NO stock
+   moves. Stock only increases when an authorised goods receipt is recorded.
+   =========================================================================== */
+function reorderUnitLabel(unit){var token=String(unit==null?"":unit).trim().toUpperCase();var labels={PIECE:"Pieces",PC:"Pieces",PCS:"Pieces",UNIT:"Units",BOTTLE:"Bottles",CAN:"Cans",SACHET:"Sachets",PACK:"Packs",PACKET:"Packs",BAG:"Bags",CRATE:"Crates",CARTON:"Cartons",CASE:"Cases",BOX:"Boxes",SACK:"Sacks",KG:"Kilograms (kg)",G:"Grams (g)",L:"Litres (L)",LITRE:"Litres (L)",ML:"Millilitres (ml)"};return labels[token]||token;}
+/* The purchase unit the operator is pricing in: the item's own base unit, or
+   one whole pack/carton/bag when the item declares how many pieces it holds. */
+function reorderPurchaseUnits(record){
+  var options=[{value:"BASE",label:"One "+reorderUnitLabel(baseUnitOf(record)).toLowerCase()+" (the stock unit)"}];
+  if(packSizeOf(record))options.push({value:"PACK",label:"One pack/bag (holds "+JONE.trimQuantityValue(String(record.units_per_pack))+" "+reorderUnitLabel(baseUnitOf(record)).toLowerCase()+")"});
+  return options;
+}
+/* Base units one selected purchase unit contains. */
+function reorderUnitsPerPurchaseUnit(purchaseUnit,record){
+  var per=packSizeOf(record);
+  return String(purchaseUnit||"BASE").toUpperCase()==="PACK"?(per>0?per:0):1;
+}
+/* Ordered quantity in the item's base unit — what the server stores. Returns
+   null when the entry cannot be converted exactly (e.g. PACK without a pack
+   size), so the dialog can refuse instead of guessing. */
+function reorderBaseQuantity(values,record){
+  var quantity=Number((values||{}).reorder_quantity||0),per=reorderUnitsPerPurchaseUnit((values||{}).purchase_unit,record);
+  if(!(quantity>0)||!(per>0))return null;
+  return trimmed(quantity*per,4);
+}
+/* Price per ONE base unit, from the price of the selected purchase unit. */
+function reorderBaseUnitCost(values,record){
+  var price=Number((values||{}).unit_purchase_price||0),per=reorderUnitsPerPurchaseUnit((values||{}).purchase_unit,record);
+  if(!(price>=0)||!(per>0))return null;
+  return trimmed(price/per,2);
